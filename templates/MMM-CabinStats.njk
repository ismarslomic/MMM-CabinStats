{% macro avatar(guest, size) %}
<li class="cabin-guest{% if guest.isFirstVisit %} cabin-guest-first{% endif %}">
  <div class="cabin-avatar cabin-avatar-{{ size }}">
    <span class="cabin-avatar-initials" aria-hidden="true">{{ guest.initials }}</span>
    {% if guest.avatarUrl %}<img class="cabin-avatar-image" src="{{ guest.avatarUrl }}" alt="">{% endif %}
    {% if guest.isTopVisitor %}<span class="cabin-avatar-badge" role="img" aria-label="{{ 'TOP_VISITOR' | translate }}">★</span>{% endif %}
  </div>
  <div class="cabin-guest-name{% if size == 'small' %} small{% else %} medium{% endif %}">{{ guest.firstName }}</div>
  {% if size == 'large' %}
  <div class="cabin-guest-visit small bright">
    {% if guest.isFirstVisit %}<span class="cabin-accent">{{ 'FIRST_VISIT' | translate }}</span>{% else %}{{ 'VISIT_NUMBER' | translate({ count: guest.visitNumber }) }}{% endif %}
  </div>
  {% endif %}
</li>
{% endmacro %}

{% if view == 'config-error' %}
<p class="cabin-stats small dimmed" role="alert">{{ 'CONFIG_ERROR' | translate }}</p>
{% elif display == 'facts' %}
{% if guestFact or cabinFact %}
<section class="cabin-stats cabin-stats-facts" aria-label="{{ 'REGION_LABEL' | translate }}">
  {% if guestFact %}<p class="cabin-fact cabin-fact-guest thin xlarge bright">{{ guestFact }}</p>{% endif %}
  {% if cabinFact %}<p class="cabin-fact cabin-fact-cabin thin large bright">{{ cabinFact }}</p>{% endif %}
</section>
{% endif %}
{% elif view == 'occupied' %}
<section class="cabin-stats" aria-label="{{ 'REGION_LABEL' | translate }}">
  <h2 class="cabin-heading large light bright">{{ 'HEADING_OCCUPIED' | translate }}</h2>
  <p class="cabin-stay small dimmed">
    {{ stay.dateRange }} ·
    {% if stay.remainingNights > 1 %}{{ 'STAY_NIGHTS_LEFT_OTHER' | translate({ count: stay.remainingNights }) }}
    {% elif stay.remainingNights == 1 %}{{ 'STAY_NIGHTS_LEFT_ONE' | translate }}
    {% else %}{{ 'STAY_LAST_DAY' | translate }}{% endif %}
  </p>
  <ul class="cabin-guests" aria-label="{{ 'GUESTS_ON_CABIN' | translate }}">
    {% for guest in guests %}{{ avatar(guest, 'large') }}{% endfor %}
  </ul>
  {% if guestFact %}<p class="cabin-fact cabin-fact-guest medium light bright">{{ guestFact }}</p>{% endif %}
  {% if nextVisit %}
  <section class="cabin-next dimmed" aria-label="{{ 'HEADING_NEXT_VISIT' | translate }}">
    <h3 class="cabin-next-heading small">{{ 'HEADING_NEXT_VISIT' | translate }} {{ nextVisit.dateRange }}</h3>
    <ul class="cabin-guests cabin-guests-small" aria-label="{{ 'GUESTS_NEXT_VISIT' | translate }}">
      {% for guest in nextVisit.guests %}{{ avatar(guest, 'small') }}{% endfor %}
    </ul>
  </section>
  {% endif %}
  {% if cabinFact %}<p class="cabin-fact cabin-fact-cabin small light dimmed">{{ cabinFact }}</p>{% endif %}
</section>
{% elif view == 'compact' %}
<section class="cabin-stats" aria-label="{{ 'REGION_LABEL' | translate }}">
  {% if nextVisit %}
  <h2 class="cabin-heading large light bright">
    {{ 'HEADING_NEXT_VISIT' | translate }}
    {% if nextVisit.daysUntil <= 0 %}{{ 'NEXT_VISIT_TODAY' | translate }}
    {% elif nextVisit.daysUntil == 1 %}{{ 'NEXT_VISIT_TOMORROW' | translate }}
    {% else %}{{ 'NEXT_VISIT_IN_DAYS' | translate({ count: nextVisit.daysUntil }) }}{% endif %}
  </h2>
  <p class="cabin-stay small dimmed">{{ nextVisit.dateRange }}</p>
  <ul class="cabin-guests cabin-guests-small" aria-label="{{ 'GUESTS_NEXT_VISIT' | translate }}">
    {% for guest in nextVisit.guests %}{{ avatar(guest, 'small') }}{% endfor %}
  </ul>
  {% if nextVisit.fact %}<p class="cabin-fact cabin-fact-guest medium light bright">{{ nextVisit.fact }}</p>{% endif %}
  {% endif %}
  {% if totals %}
  <ul class="cabin-totals small dimmed" aria-label="{{ 'TOTALS_LABEL' | translate }}">
    <li><span class="cabin-accent bright">{{ totals.visits }}</span> {{ 'TOTAL_VISITS' | translate }}</li>
    <li><span class="cabin-accent bright">{{ totals.nights }}</span> {{ 'TOTAL_NIGHTS' | translate }}</li>
    <li><span class="cabin-accent bright">{{ totals.uniqueGuests }}</span> {{ 'TOTAL_GUESTS' | translate }}</li>
  </ul>
  {% endif %}
  {% if cabinFact %}<p class="cabin-fact cabin-fact-cabin small light dimmed">{{ cabinFact }}</p>{% endif %}
</section>
{% endif %}
