{# ============================================================
   Macros
   ============================================================ #}

{# One guest avatar. size: 'large' | 'small'. interactive: wrap in a button that opens the guest stats view. #}
{% macro avatar(guest, size, interactive) %}
<li class="cabin-guest{% if guest.isFirstVisit %} cabin-guest-first{% endif %}">
  {% if interactive %}
  <button type="button"
          class="cabin-guest-button"
          data-cabin-guest-id="{{ guest.guestId }}"
          aria-label="{{ 'OPEN_GUEST_STATS' | translate({ name: guest.firstName }) }}">
  {% endif %}

  <div class="cabin-avatar cabin-avatar-{{ size }}">
    <span class="cabin-avatar-initials" aria-hidden="true">{{ guest.initials }}</span>
    {% if guest.avatarUrl %}
    <img class="cabin-avatar-image" src="{{ guest.avatarUrl }}" alt="">
    {% endif %}
    {% if guest.isTopVisitor %}
    <span class="cabin-avatar-badge" role="img" aria-label="{{ 'TOP_VISITOR' | translate }}">★</span>
    {% endif %}
  </div>

  <div class="cabin-guest-name{% if size == 'small' %} small{% else %} medium{% endif %}">{{ guest.firstName }}</div>

  {% if size == 'large' %}
  <div class="cabin-guest-visit small bright">
    {% if guest.isFirstVisit %}
    <span class="cabin-accent">{{ 'FIRST_VISIT' | translate }}</span>
    {% else %}
    {{ 'VISIT_NUMBER' | translate({ count: guest.visitNumber }) }}
    {% endif %}
  </div>
  {% endif %}

  {% if interactive %}</button>{% endif %}
</li>
{% endmacro %}

{# Fun fact about the guests, shown the same way in the occupied and compact views. #}
{% macro guestFactLine(text) %}
{% if text %}
<p class="cabin-fact cabin-fact-guest medium light bright">{{ text }}</p>
{% endif %}
{% endmacro %}

{# Fun fact about the cabin, shown the same way in the occupied and compact views. #}
{% macro cabinFactLine(text) %}
{% if text %}
<p class="cabin-fact cabin-fact-cabin small light dimmed">{{ text }}</p>
{% endif %}
{% endmacro %}


{# ============================================================
   Views
   ============================================================ #}

{# --- Config error --- #}
{% if view == 'config-error' %}
<p class="cabin-stats small dimmed" role="alert">{{ 'CONFIG_ERROR' | translate }}</p>


{# --- Facts only (display: 'facts') --- #}
{% elif display == 'facts' %}
  {% if guestFact or cabinFact %}
  <section class="cabin-stats cabin-stats-facts" aria-label="{{ 'REGION_LABEL' | translate }}">
    {% if guestFact %}
    <p class="cabin-fact cabin-fact-guest thin xlarge bright">{{ guestFact }}</p>
    {% endif %}
    {% if cabinFact %}
    <p class="cabin-fact cabin-fact-cabin thin large bright">{{ cabinFact }}</p>
    {% endif %}
  </section>
  {% endif %}


{# --- Cabin is occupied --- #}
{% elif view == 'occupied' %}
<section class="cabin-stats" aria-label="{{ 'REGION_LABEL' | translate }}">
  <h2 class="cabin-heading large light bright">{{ 'HEADING_OCCUPIED' | translate }}</h2>

  <p class="cabin-stay small dimmed">
    {{ stay.dateRange }} ·
    {% if stay.remainingNights > 1 %}
    {{ 'STAY_NIGHTS_LEFT_OTHER' | translate({ count: stay.remainingNights }) }}
    {% elif stay.remainingNights == 1 %}
    {{ 'STAY_NIGHTS_LEFT_ONE' | translate }}
    {% else %}
    {{ 'STAY_LAST_DAY' | translate }}
    {% endif %}
  </p>

  {# Current guests #}
  <ul class="cabin-guests" aria-label="{{ 'GUESTS_ON_CABIN' | translate }}">
    {% for guest in guests %}{{ avatar(guest, 'large', guestView) }}{% endfor %}
  </ul>

  {{ guestFactLine(guestFact) }}

  {# Upcoming visit #}
  {% if nextVisit %}
  <section class="cabin-next dimmed" aria-label="{{ 'HEADING_NEXT_VISIT' | translate }}">
    <h3 class="cabin-next-heading small">{{ 'HEADING_NEXT_VISIT' | translate }} {{ nextVisit.dateRange }}</h3>
    <ul class="cabin-guests cabin-guests-small" aria-label="{{ 'GUESTS_NEXT_VISIT' | translate }}">
      {% for guest in nextVisit.guests %}{{ avatar(guest, 'small', guestView) }}{% endfor %}
    </ul>
  </section>
  {% endif %}

  {{ cabinFactLine(cabinFact) }}
</section>


{# --- Cabin is empty: next visit and totals --- #}
{% elif view == 'compact' %}
<section class="cabin-stats" aria-label="{{ 'REGION_LABEL' | translate }}">

  {# Upcoming visit #}
  {% if nextVisit %}
  <h2 class="cabin-heading large light bright">
    {{ 'HEADING_NEXT_VISIT' | translate }}
    {% if nextVisit.daysUntil <= 0 %}
    {{ 'NEXT_VISIT_TODAY' | translate }}
    {% elif nextVisit.daysUntil == 1 %}
    {{ 'NEXT_VISIT_TOMORROW' | translate }}
    {% else %}
    {{ 'NEXT_VISIT_IN_DAYS' | translate({ count: nextVisit.daysUntil }) }}
    {% endif %}
  </h2>
  <p class="cabin-stay small dimmed">{{ nextVisit.dateRange }}</p>

  <ul class="cabin-guests cabin-guests-small" aria-label="{{ 'GUESTS_NEXT_VISIT' | translate }}">
    {% for guest in nextVisit.guests %}{{ avatar(guest, 'small', guestView) }}{% endfor %}
  </ul>

  {{ guestFactLine(guestFact) }}
  {% endif %}

  {# All-time totals #}
  {% if totals %}
  <ul class="cabin-totals small dimmed" aria-label="{{ 'TOTALS_LABEL' | translate }}">
    <li><span class="cabin-accent bright">{{ totals.visits }}</span> {{ 'TOTAL_VISITS' | translate }}</li>
    <li><span class="cabin-accent bright">{{ totals.nights }}</span> {{ 'TOTAL_NIGHTS' | translate }}</li>
    <li><span class="cabin-accent bright">{{ totals.uniqueGuests }}</span> {{ 'TOTAL_GUESTS' | translate }}</li>
  </ul>
  {% endif %}

  {{ cabinFactLine(cabinFact) }}
</section>
{% endif %}
