{
  "name": "mmm-cabinstats",
  "version": "1.0.0",
  "description": "MagicMirror module showing live cabin visit stats and fun facts",
  "main": "MMM-CabinStats.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismarslomic/MMM-CabinStats.git"
  },
  "author": "ismar@slomic.no",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ismarslomic/MMM-CabinStats/issues"
  },
  "homepage": "https://github.com/ismarslomic/MMM-CabinStats",
  "scripts": {
    "build": "rollup -c",
    "lint": "eslint .",
    "lint:report": "eslint . --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif",
    "lint:fix": "eslint . --fix",
    "prettier": "npx prettier --check .",
    "prettier:fix": "npx prettier --write .",
    "dev": "rollup -c --sourcemap=inline",
    "dev:watch": "npm run dev -- --watch",
    "prepare": "node scripts/install-hooks.mjs",
    "install:dep": "npm ci --omit=dev",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.frontend.json && tsc --noEmit -p tsconfig.backend.json && tsc --noEmit -p tsconfig.unit.json && tsc -p __tests__/e2e/tsconfig.json",
    "lint:css": "stylelint \"css/**/*.css\"",
    "check:generated": "npm run generate:api && npm run build && git diff --exit-code -- src/types/api.generated.ts MMM-CabinStats.js MMM-CabinStats.js.map node_helper.js node_helper.js.map",
    "generate:api": "openapi-typescript openapi/cabin-visits.json -o src/types/api.generated.ts"
  },
  "overrides": {
    "@microsoft/eslint-formatter-sarif": {
      "eslint": "$eslint"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/magicmirror-module": "^2.16.6",
    "@types/node": "^26.6.5",
    "@types/nunjucks": "^3.2.6",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nunjucks": "^3.2.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
